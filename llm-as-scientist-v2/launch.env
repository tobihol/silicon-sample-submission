# What idea_03's container may see — read by utils/prime/run.sh before the mount set is built.
# Variables already set by the caller win (each line is a default, not an override).
#
# Ten datasets are absent from /workspace/datasets entirely:
# - seven validation studies (design-only briefs are mounted instead, from run/inputs/val/)
# - the internal-test battery's anchor study (evaluation forks only)
# - bokemper2022 (jointly held-out referee, both ideas)
# - hewitt2026 (mount-level diet: high memorization risk — 70 published TESS experiments;
#   excluded by the environment, not by instructing the agent)
SSB_DATASET_EXCLUDE=${SSB_DATASET_EXCLUDE:-goldwert2026,bbprime2025,orchinik2024,kim2024,dablander2025,altenmueller2024,kerwer2025,beall2017,bokemper2022,hewitt2026}

# Prime's auto-refine writes a session-local ledger; promote it to the arm after every run.
SSB_LEDGER_PROMOTE=${SSB_LEDGER_PROMOTE:-1}

# Same long-campaign budgets as idea_02 (24 continuations / 800 turns / 24M tokens / 6h).
SSB_AUTONOMOUS_MAX_CONTINUATIONS=${SSB_AUTONOMOUS_MAX_CONTINUATIONS:-24}
SSB_AUTONOMOUS_MAX_TURNS=${SSB_AUTONOMOUS_MAX_TURNS:-800}
SSB_AUTONOMOUS_MAX_TOKENS=${SSB_AUTONOMOUS_MAX_TOKENS:-24000000}
SSB_AUTONOMOUS_TIMEOUT_MS=${SSB_AUTONOMOUS_TIMEOUT_MS:-21600000}
